# Variables de entorno de ejemplo (sin valores reales). Copiar a .env y completar localmente.
# Cada app documenta las suyas en apps/<app>/.env.example; el detalle por servicio y de dónde sale cada valor
# está en docs/deploy.md.

# Tests de integración: superusuario de la base local (supabase start).
DATABASE_URL=

# scripts/setup_proyecto.py (una vez por proyecto): conexión directa como dueño de las migraciones.
SETUP_DATABASE_URL=
# Contraseñas de los 6 roles de login (opcionales: o se piden con --pedir-passwords).
SETUP_PASSWORD_BOT_SERVICE=
SETUP_PASSWORD_DASHBOARD_SERVICE=
SETUP_PASSWORD_PLATFORM_ADMIN=
SETUP_PASSWORD_PLATFORM_ADMIN_READONLY=
SETUP_PASSWORD_PURGE_JOB=
SETUP_PASSWORD_SCHEDULER_JOB=

SUPABASE_URL=
SENTRY_DSN=
