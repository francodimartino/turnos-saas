# admin-backend: variables de entorno (sin valores; cargarlas en el hosting, nunca commitear un .env)

# Conexión directa a Postgres como el rol `platform_admin` (no el dueño de las migraciones)
ADMIN_DATABASE_URL=
# Conexión directa como el rol `platform_admin_readonly` (solo SELECT): impersonación de solo lectura
ADMIN_READONLY_DATABASE_URL=
# URL del proyecto Supabase (https; http solo hacia loopback en desarrollo)
SUPABASE_URL=
# Anon key: la usa el proxy de login/MFA
SUPABASE_ANON_KEY=
# service_role: SOLO para la Auth Admin API (invitar al owner de un tenant nuevo)
SUPABASE_SERVICE_ROLE_KEY=
# Verificación de JWT (uno de los dos, ver platform_auth)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Único origen del admin-frontend (esquema://host[:puerto])
ADMIN_ORIGIN=
# Opcionales
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_REFRESH_MAX_AGE=
DB_STATEMENT_CACHE_SIZE=
SENTRY_DSN=
