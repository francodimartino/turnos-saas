# Variables de entorno del servicio enviador (sin valores reales). Copiar a .env y completar localmente.
# Arranque: uvicorn enviador_app.main:crear_app_desde_entorno --factory --no-server-header --host 0.0.0.0 --port $PORT
# Todas se validan al arrancar: un valor ausente (obligatorias) o fuera de rango impide arrancar.

# Obligatorias
# Conexión como el rol enviador (también vale el usuario del pooler de Supabase: enviador.<ref>).
ENVIADOR_DATABASE_URL=
# Resend: clave de la cuenta y remitente verificado (dirección @agendemos.ar, o "Nombre <dirección>").
RESEND_API_KEY=
EMAIL_REMITENTE=

# Opcionales
# DSN del proyecto de Sentry turnos-enviador; sin DSN no hay Sentry.
SENTRY_DSN=
# Solo para un simulador local de Telegram (http hacia localhost); sin definir usa la API oficial.
TELEGRAM_API_BASE_URL=

# Ajustes (si se omiten, rige el valor entre paréntesis)
# Espera entre reclamos con trabajo (2 s); sin trabajo se duplica hasta ENVIADOR_ESPERA_MAXIMA_SEG (10 s).
ENVIADOR_INTERVALO_SEG=
ENVIADOR_ESPERA_MAXIMA_SEG=
# Filas por reclamo (10) y filas en simultáneo (5); llamadas externas simultáneas de todo el lote (10).
ENVIADOR_LOTE=
ENVIADOR_CONCURRENCIA=
ENVIADOR_CONCURRENCIA_ENVIOS=
# Tope del envío de una fila (300 s; al menos el peor caso de un canal con reintentos) y espera de las filas en curso
# al recibir SIGTERM (20 s).
ENVIADOR_PLAZO_FILA_SEG=
ENVIADOR_PLAZO_APAGADO_SEG=
# Arriendo de una fila reclamada (900 s; tiene que superar el peor caso del lote), espera antes de reintentar una fila
# reprogramada (300 s) y reclamos antes de dejarla failed (5).
OUTBOX_ARRIENDO_SEG=
OUTBOX_REINTENTO_SEG=
OUTBOX_MAX_INTENTOS=
