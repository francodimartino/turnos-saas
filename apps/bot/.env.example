# Variables de entorno del bot (sin valores reales). Copiar a .env y completar localmente.
# Conexión como el rol bot_service (el bot rechaza arrancar con otro rol). Con el pooler de Supabase en modo
# transacción no hace falta nada más: el pool ya usa statement_cache_size=0.
BOT_DATABASE_URL=
SENTRY_DSN=
# Google Calendar (platform_calendar): las mismas tres que el dashboard-backend (el bot no inicia OAuth: no lleva la clave del state).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Tope de tamaño del body (bytes). Por defecto 1 MiB (un update de Telegram pesa pocos KB); excedido responde 413.
# HTTP_MAX_BODY_BYTES=1048576
