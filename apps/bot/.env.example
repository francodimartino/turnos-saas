# Variables de entorno del bot (sin valores reales). Copiar a .env y completar localmente.
# Conexión como el rol bot_service (el bot rechaza arrancar con otro rol). Con el pooler de Supabase en modo
# transacción no hace falta nada más: el pool ya usa statement_cache_size=0.
BOT_DATABASE_URL=
SENTRY_DSN=
# Google Calendar (platform_calendar): las mismas cuatro que el dashboard-backend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CALENDAR_OAUTH_STATE_SECRET=
