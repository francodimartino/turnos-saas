# Variables de entorno de los Cron Jobs (sin valores reales). Copiar a .env y completar localmente.

# jobs_vencimiento (python -m jobs_vencimiento): conexión como el rol scheduler_job.
SCHEDULER_DATABASE_URL=

# jobs_purga (python -m jobs_purga): conexión como el rol purge_job.
PURGE_DATABASE_URL=
# Horario crontab UTC del monitor de Sentry; debe coincidir con el schedule del Cron Job. Opcional.
PURGA_CRON=
# service_role: solo para eliminar cuentas por la Auth Admin API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Calendar (la purga desvincula calendarios): sin estas, ese paso falla y la purga sigue.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CALENDAR_OAUTH_STATE_SECRET=

# Ambos jobs
SENTRY_DSN=
