# Variables de entorno del dashboard-backend (sin valores reales). Copiar a .env y completar localmente.
# Conexión directa como el rol dashboard_service (nunca el dueño de las migraciones).
DASHBOARD_DATABASE_URL=
# Solo "0" si se conecta por el pooler de Supabase en modo transacción.
DB_STATEMENT_CACHE_SIZE=
SUPABASE_URL=
# anon key: la usa el servicio para login y MFA.
SUPABASE_ANON_KEY=
# service_role (secret key): la usa para invitar al staff (Auth Admin API) y para subir y borrar el logo del
# negocio en el bucket `logos` de Storage (público de solo lectura: solo el dashboard sube y borra).
# Obligatoria: sin ella el servicio no arranca.
SUPABASE_SERVICE_ROLE_KEY=
# Verificación de JWT (platform_auth): exactamente una de las dos.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Opcionales: audiencia (defecto "authenticated") y emisor esperado del JWT
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWT_ISSUER=
# Único origen del dashboard-frontend (CORS y comprobación de origen), sin barra final ni ruta.
DASHBOARD_ORIGIN=
# Cookies de sesión: true y strict por defecto; false solo en desarrollo sobre http.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_REFRESH_MAX_AGE=
SENTRY_DSN=
# Protección de login (ver README): captcha Turnstile (vacío = apagado), header de IP real
# (CF-Connecting-IP o X-Forwarded-For; vacío = IP del socket) y límites (enteros >= 1).
TURNSTILE_SECRET_KEY=
LOGIN_IP_HEADER=
LOGIN_PROXIES_CONFIABLES=
LOGIN_LIMITE_IP=
LOGIN_LIMITE_EMAIL=
LOGIN_LIMITE_REFRESCO=
LOGIN_VENTANA_SEG=
# Google Calendar por profesional (platform_calendar). Sin estas cuatro, conectar calendarios responde 503.
# REDIRECT_URI: la URL que se registra en el proyecto de Google (el callback del backend, o una página del dashboard).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Clave de firma del state de OAuth: al azar, de al menos 16 caracteres.
CALENDAR_OAUTH_STATE_SECRET=

# Tope de tamaño del body de cualquier request (bytes). Por defecto 1 MiB; excedido responde 413.
# HTTP_MAX_BODY_BYTES=1048576
