# Variables de entorno del dashboard-backend (sin valores reales). Copiar a .env y completar localmente.
# Conexión directa como el rol dashboard_service (nunca el dueño de las migraciones).
DASHBOARD_DATABASE_URL=
# Solo "0" si se conecta por el pooler de Supabase en modo transacción.
DB_STATEMENT_CACHE_SIZE=
SUPABASE_URL=
# anon key: la única clave de Supabase que usa este servicio para login/MFA/invitación.
SUPABASE_ANON_KEY=
# Verificación de JWT (platform_auth): exactamente una de las dos.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Único origen del dashboard-frontend (CORS y comprobación de origen), sin barra final ni ruta.
DASHBOARD_ORIGIN=
# Cookies de sesión: true y strict por defecto; false solo en desarrollo sobre http.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_REFRESH_MAX_AGE=
SENTRY_DSN=
