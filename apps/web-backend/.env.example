# Variables del web-backend (ver web_backend/config.py). Valores de ejemplo para desarrollo local: ninguno es real.
# Rol de Postgres `web_reservas`, de mínimo privilegio (nunca el dueño de las migraciones).
WEB_DATABASE_URL=postgresql://web_reservas:<clave-del-rol>@127.0.0.1:54322/postgres
# Único origen que puede llamar a la API desde un navegador (CORS). En producción: https://agendemos.ar
WEB_ORIGIN=http://localhost:5174
# Opcional y no secreta: URL del proyecto de Supabase, para armar la URL pública del logo. Sin ella, sin logo.
# El servicio no usa ninguna clave de Storage.
# SUPABASE_URL=http://127.0.0.1:54321
# SENTRY_DSN=
# DB_STATEMENT_CACHE_SIZE=0
# HTTP_MAX_BODY_BYTES=16384
