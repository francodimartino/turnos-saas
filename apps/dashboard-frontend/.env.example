# Variables públicas: Vite las incrusta en el bundle que baja al navegador. Nunca van secretos acá.
# URL del dashboard-backend (origen del API). Con SameSite=Strict, frontend y backend deben ser el mismo sitio.
VITE_API_URL=http://localhost:8000
# DSN de Sentry (el DSN es público por diseño). Vacío = Sentry apagado.
VITE_SENTRY_DSN=
# Site key pública de Cloudflare Turnstile (anti-bots en login e invitación). Va en par con TURNSTILE_SECRET_KEY del
# backend: deben configurarse juntas. Vacía = sin captcha.
VITE_TURNSTILE_SITE_KEY=
